/**
 * tracker-mcp: the user's to-do tracker as a remote MCP server.
 * Config reference: https://developers.cloudflare.com/workers/wrangler/configuration/
 *
 * Secrets (never put these in this file; see SETUP.md):
 *   npx wrangler secret put GITHUB_CLIENT_ID        # GitHub OAuth App (sign-in)
 *   npx wrangler secret put GITHUB_CLIENT_SECRET    # GitHub OAuth App (sign-in)
 *   npx wrangler secret put COOKIE_ENCRYPTION_KEY   # openssl rand -hex 32
 *   npx wrangler secret put GITHUB_TRACKER_TOKEN    # fine-grained PAT, Contents R/W on the tracker repo only
 */
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "tracker-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  // global_fetch_strictly_public: fetch() can only reach the public internet,
  // which workers-oauth-provider requires before it will fetch client metadata.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "workers_dev": true,
  "preview_urls": false,
  "migrations": [
    {
      "new_sqlite_classes": ["TrackerMCP"],
      "tag": "v1"
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "TrackerMCP",
        "name": "MCP_OBJECT"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      // Replace with the id printed by: npx wrangler kv namespace create OAUTH_KV
      "id": "YOUR_KV_NAMESPACE_ID"
    }
  ],
  // Secret NAMES only (values are set with `wrangler secret put`, see SETUP.md).
  // Declaring them lets `wrangler types` type them and `wrangler dev` warn if one is missing.
  "secrets": {
    "required": ["GITHUB_CLIENT_ID", "GITHUB_CLIENT_SECRET", "COOKIE_ENCRYPTION_KEY", "GITHUB_TRACKER_TOKEN"]
  },
  "vars": {
    // Comma- or space-separated GitHub logins allowed to sign in and use the
    // tools. Checked at sign-in AND on every request. Set to "" to lock
    // everyone out instantly (then redeploy).
    "ALLOWED_GITHUB_LOGINS": "YOUR-GITHUB-LOGIN",
    "TRACKER_REPO": "YOUR-GITHUB-LOGIN/semester-heartbeat",
    "TRACKER_BRANCH": "main",
    "TRACKER_PATH": "deadlines.json"
  },
  "observability": {
    "enabled": true
  },
  "dev": {
    "port": 8788
  }
}
