{
	"compilerOptions": {
		"target": "es2022",
		"lib": ["es2022"],
		"module": "es2022",
		"moduleResolution": "bundler",
		/* Runtime + binding types come from worker-configuration.d.ts (`npm run cf-typegen`). */
		"types": ["node"],
		"resolveJsonModule": true,
		"allowJs": true,
		"checkJs": false,
		"noEmit": true,
		"isolatedModules": true,
		"allowSyntheticDefaultImports": true,
		"forceConsistentCasingInFileNames": true,
		"strict": true,
		"skipLibCheck": true
	},
	"include": ["worker-configuration.d.ts", "src/**/*.ts", "test/**/*.ts", "test-e2e/**/*.ts", "vitest.config.ts", "vitest.e2e.config.ts"]
}
