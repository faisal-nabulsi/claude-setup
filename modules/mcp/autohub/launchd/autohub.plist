<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>{{LABEL_PREFIX}}.autohub</string>
  <key>ProgramArguments</key>
  <array>
    <string>/opt/homebrew/bin/python3</string>
    <string>{{HOME}}/code/autohub/autohub.py</string>
    <string>tick</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict><key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string><key>CANVAS_HOST</key><string>{{CANVAS_HOST}}</string><key>SEMESTER_TRACKER</key><string>{{HOME}}/semester-tracker</string></dict>
  <key>StartInterval</key><integer>300</integer>
  <key>RunAtLoad</key><true/>
  <key>ProcessType</key><string>Background</string>
  <key>Nice</key><integer>10</integer>
  <key>LowPriorityIO</key><true/>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/autohub.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/autohub.log</string>
</dict>
</plist>
