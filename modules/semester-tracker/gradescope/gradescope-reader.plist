<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Runs the Gradescope reader at 7:20am, 1:20pm, 7:20pm and 10:20pm.
     Install: cp this file to {{HOME}}/Library/LaunchAgents/, then
     launchctl bootstrap gui/$(id -u) {{HOME}}/Library/LaunchAgents/{{LABEL_PREFIX}}.gradescope-reader.plist
     Remove:  launchctl bootout gui/$(id -u)/{{LABEL_PREFIX}}.gradescope-reader and delete the copy. -->
<plist version="1.0">
<dict>
  <key>Label</key><string>{{LABEL_PREFIX}}.gradescope-reader</string>
  <key>ProgramArguments</key>
  <array>
    <string>{{HOME}}/.local/share/gradescope-reader/venv/bin/python</string>
    <string>{{HOME}}/semester-tracker/gradescope/reader.py</string>
  </array>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
  </dict>
  <key>StartCalendarInterval</key>
  <array>
    <dict><key>Hour</key><integer>7</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>13</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>19</integer><key>Minute</key><integer>20</integer></dict>
    <dict><key>Hour</key><integer>22</integer><key>Minute</key><integer>20</integer></dict>
  </array>
  <key>RunAtLoad</key><false/>
  <key>ProcessType</key><string>Background</string>
  <key>StandardOutPath</key><string>{{HOME}}/Library/Logs/gradescope-reader.log</string>
  <key>StandardErrorPath</key><string>{{HOME}}/Library/Logs/gradescope-reader.log</string>
</dict>
</plist>
